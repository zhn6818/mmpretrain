{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train ResNet18 Finetune",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/train.py",
            "args": [
                "charCls/resnet18/resnet18_finetune.py",
                "--work-dir=charCls/works/resnet18"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Train Swin Transformer swin_transformer_tiny",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/train.py",
            "args": [
                "charCls/swin_transformer/swin_transformer_tiny_images.py",
                "--work-dir=charCls/works/swin_transformer_tiny"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "OMP_NUM_THREADS": "1",
                "MKL_NUM_THREADS": "1",
                "PYTORCH_CUDA_ALLOC_CONF": "max_split_size_mb:32"
            }
        },
        {
            "name": "Train Swin Transformer swin_transformer_small",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/train.py",
            "args": [
                "charCls/swin_transformer/swin_transformer_small_images.py",
                "--work-dir=charCls/works/swin_transformer_small"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "OMP_NUM_THREADS": "1",
                "MKL_NUM_THREADS": "1",
                "PYTORCH_CUDA_ALLOC_CONF": "max_split_size_mb:32"
            }
        },
        {
            "name": "Train Swin Transformer swin_transformer_base",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/train.py",
            "args": [
                "charCls/swin_transformer/swin_transformer_base_finetune.py",
                "--work-dir=charCls/works/swin_transformer_base"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "OMP_NUM_THREADS": "1",
                "MKL_NUM_THREADS": "1",
                "PYTORCH_CUDA_ALLOC_CONF": "max_split_size_mb:32"
            }
        },
        {
            "name": "Analyze Results",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/analysis_tools/analyze_results.py",
            "args": [
                "charCls/resnet18_finetune.py"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Test Model",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/test.py",
            "args": [
                "charCls/resnet18_finetune.py",
                "charCls/works/epoch_50.pth",
                "--out",
                "charCls/result.pkl"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Inference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/charCls/inference.py",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}